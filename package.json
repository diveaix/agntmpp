{
  "name": "@agnt/mcp",
  "version": "2.1.0",
  "description": "Agent-native DeFi toolkit — 56 MPP-enabled MCP tools with pay-per-call via USDC.e",
  "type": "module",
  "bin": {
    "agnt-mcp": "./bin/agnt-mcp.js"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"node --import tsx/esm --watch src/server/index.ts\" \"tsx src/mcp/serve.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "vite build",
    "start": "node dist/server/index.js",
    "mcp": "tsx src/mcp/server.ts",
    "mcp:serve": "tsx src/mcp/serve.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@nktkas/hyperliquid": "^0.32.2",
    "@polymarket/clob-client-v2": "^1.0.2",
    "@tailwindcss/vite": "^4.2.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "framer-motion": "^12.38.0",
    "hono": "^4.7.10",
    "jsonwebtoken": "^9.0.3",
    "mppx": "^0.5.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "uuid": "^14.0.0",
    "viem": "^2.48.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
