# Core
NODE_ENV=development
AGNT_PORT=3001
PORT=3000
AGNT_PASSPHRASE=replace_with_a_long_random_secret

# Local encrypted state paths
AGNT_ACCESS_STORE_PATH=.agnt/access.enc
AGNT_WALLET_PATH=.agnt/wallets.enc
AGNT_WALLET_DIR=.agnt/wallets
AGNT_WALLET_VAULT_PATH=.agnt/wallet-vault.enc
AGNT_WALLET_VAULT_DIR=.agnt/wallet-vaults
AGNT_AUTOMATIONS_PATH=.agnt/automations.enc
AGNT_ACTIVITY_LOG_PATH=.agnt/activity-log.enc
AGNT_MEMORY_PATH=.agnt/memory.enc
AGNT_PAYMENTS_PATH=.agnt/payments.enc

# Website -> MCP upstream
AGNT_MCP_HTTP_URL=http://localhost:3001

# Hosted access mode
# In production this should be true. Local development can leave it false.
AGNT_ACCESS_REQUIRED=false

# Optional MPP micropayment gate.
# Leave false/unset for API-key access without per-call payment prompts.
AGNT_MPP_ENABLED=false

# Crypto checkout
AGNT_RECIPIENT=0x0000000000000000000000000000000000000000
AGNT_PAYMENT_CURRENCY=0x20C000000000000000000000b9537d11c60E8b50
AGNT_PAYMENT_CHAIN_ID=6342
AGNT_PAYMENT_RPC_URL=https://rpc.tempo.xyz
CRYPTO_ACCESS_NETWORK=tempo
CRYPTO_ACCESS_PRO_USDC=49
CRYPTO_ACCESS_MAX_USDC=199
CRYPTO_ACCESS_TOKEN_DECIMALS=6
CRYPTO_ACCESS_MIN_CONFIRMATIONS=2
AGNT_NATIVE_MAX_RESERVE_ETH=0.0005

# Optional RPC overrides
TEMPO_RPC_URL=https://rpc.tempo.xyz
AGNT_POLYGON_RPC_URL=

# Optional protocol credentials
AGNT_POLYMARKET_KEY=
AGNT_POLYMARKET_SECRET=
AGNT_POLYMARKET_PASSPHRASE=

# Twitter/X + Grok automations
TWITTERAPI_IO_KEY=
TWITTERAPI_IO_BASE_URL=https://api.twitterapi.io
TWITTERAPI_IO_POLL_MS=5000
TWITTERAPI_IO_TWEETS_PER_SOURCE=5
AGNT_EVENT_AUTO_EXECUTE_ENABLED=false
AGNT_FAST_VERIFY_DEFAULT_MODE=balanced
AGNT_FAST_VERIFY_MAX_TWEET_AGE_MS=120000
AGNT_FAST_VERIFY_AUDIT_ENABLED=true
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
GROK_VERIFY_MODEL=grok-4.20-reasoning
GROK_VERIFY_TIMEOUT_MS=8000
GROK_VERIFY_MIN_CONFIDENCE=0.8

# Dashboard email
# console prints codes locally. Production should use a real email provider.
AGNT_EMAIL_PROVIDER=console

# Waitlist capture (Vercel serverless API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional admin and integrations
AGNT_ADMIN_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
DUNE_API_KEY=
