# Local defaults
NODE_ENV=development
AGNT_PORT=3001
PORT=3000
AGNT_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Generate a unique secret of at least 32 characters. Never commit the real value.
AGNT_PASSPHRASE=replace-with-a-random-secret-at-least-32-characters

# Production supports one process/replica backed by a persistent .agnt volume.
AGNT_SINGLE_INSTANCE=false

# Local encrypted state paths. Mount .agnt on persistent storage in production.
AGNT_ACCESS_STORE_PATH=.agnt/access.enc
AGNT_WALLET_PATH=.agnt/wallets.enc
AGNT_WALLET_DIR=.agnt/wallets
AGNT_WALLET_VAULT_PATH=.agnt/wallet-vault.enc
AGNT_WALLET_VAULT_DIR=.agnt/wallet-vaults
AGNT_AUTOMATIONS_PATH=.agnt/automations.enc
AGNT_ACTIVITY_LOG_PATH=.agnt/activity-log.enc
AGNT_MEMORY_PATH=.agnt/memory.enc
AGNT_PAYMENTS_PATH=.agnt/payments.enc

# Website -> MCP upstream
AGNT_MCP_HTTP_URL=http://localhost:3001

# Authentication is always enforced in production.
AGNT_ACCESS_REQUIRED=false

# Production email delivery. The endpoint receives JSON:
# { "to", "template": "agnt_login_code", "code", "expiresAt" }
AGNT_EMAIL_PROVIDER=console
AGNT_EMAIL_WEBHOOK_URL=
AGNT_EMAIL_WEBHOOK_SECRET=

# Transaction execution is disabled by default in production.
AGNT_LIVE_EXECUTION_ENABLED=false

# Gas reserve for supported native-asset all/max routes.
AGNT_NATIVE_MAX_RESERVE_ETH=0.0005

AGNT_POLYGON_RPC_URL=




# Optional admin and waitlist integrations
AGNT_ADMIN_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Access-pass development database (server only; never VITE_).
# Provision PostgreSQL and run npm run sale:migrate before using sale accounting.
AGNT_SALE_DATABASE_URL=
# Terms are intentionally undecided. Leave blank until approved.
# Duration and daily allowance are stored in the sale database through explicit
# closed/unissued policy configuration, not environment variables.
AGNT_PASS_ACCESS_REQUIRED=false
# Dedicated receipt signer process only. Do not set these in the web/API environment.
AGNT_RECEIPT_SIGNER_ENABLED=false
AGNT_RECEIPT_SIGNING_KEY_FILE=
AGNT_RECEIPT_DATABASE_URL=
# These settings do not enable deposits, purchases, or withdrawals over HTTP.
# Real-money routes remain locked pending verified Zcash settlement integration.

# Optional bounded observer job: npm run sale:scan. Disabled until explicitly configured.
# Enabling this processes deposit accounting; it does not open HTTP funding or sales.
# Use a dedicated read-only wallet RPC identity and a validating node.
AGNT_SALE_OBSERVER_ENABLED=false
# Private in-app inbox delivery only; does not send email or sign/broadcast.
AGNT_SALE_NOTIFICATIONS_ENABLED=false
AGNT_SALE_PROVIDERS_ENABLED=false
AGNT_ZALLET_DEPOSIT_ACCOUNT=
# Provider configuration does NOT remove the HTTP launch lock.
AGNT_ZCASH_NETWORK=
AGNT_ZCASH_GENESIS_HASH=
# Verified collection/account birthday and approved confirmation threshold.
AGNT_SALE_SCAN_START_HEIGHT=
AGNT_SALE_CONFIRMATIONS=
# HTTPS or authenticated loopback tunnels only. Never expose these as VITE_ values.
AGNT_ZALLET_RPC_URL=
AGNT_ZALLET_RPC_USER=
AGNT_ZALLET_RPC_PASSWORD=
AGNT_ZEBRA_RPC_URL=
AGNT_ZEBRA_RPC_USER=
AGNT_ZEBRA_RPC_PASSWORD=

# Isolated operator signer environment ONLY; do not configure these in the web API.
# npm run sale:sign -- <approved-withdrawal-uuid> never approves or broadcasts.
# Requires explicit signer schema migration and restricted database/RPC roles.
# Leave disabled until the signer environment and operational policy are verified.
AGNT_SALE_SIGNER_ENABLED=false
AGNT_SALE_SIGNER_DATABASE_URL=
AGNT_ZALLET_SIGNER_ACCOUNT=
AGNT_ZALLET_SIGNER_RPC_URL=
AGNT_ZALLET_SIGNER_RPC_USER=
AGNT_ZALLET_SIGNER_RPC_PASSWORD=
# Separate operator payout process; use a read-only signer-artifact database role.
# npm run sale:payout -- broadcast <withdrawal-uuid>
# npm run sale:payout -- settle <withdrawal-uuid> <candidate-block-hash>
# npm run sale:payout -- review <paid-withdrawal-uuid>
# No signing or approval occurs. Never enable before operational verification.
AGNT_SALE_PAYOUTS_ENABLED=false
